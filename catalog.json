        {
          "type": "wago",
          "slug": "needroll"
        }
      ],
      "folders": [
        "NeedRoll"
      ],
      "tocPath": "NeedRoll/NeedRoll.toc"
    },
    {
      "id": "openmap",
      "name": "OpenMap",
      "author": "jigrobbulus",
      "summary": "A continuous, zoomable world map, with Questie's icons when Questie is installed.",
      "tags": [
        "map"
      ],
      "added": "2026-11-20",
      "repository": "https://github.com/openmap-world/openmap",
      "issues": "https://github.com/openmap-world/openmap/issues",
      "sources": [
        {
          "type": "github",
          "repo": "openmap-world/openmap",
          "assetPattern": "^OpenMap-.*\\.zip$",
          "excludePattern": "retail"
        },
        {
          "type": "curseforge",
          "projectId": 1735937,
          "downloadPage": "https://www.curseforge.com/wow/addons/openmap/files/all?gameVersionTypeId=88568"
        }
      ],
      "folders": [
        "OpenMap"
      ],
      "tocPath": "OpenMap/OpenMap.toc",
      "optional": [
        "questie"
      ],
      "notes": "Large download (about 175 MB). New textures need a game restart, not just /reload."
    },
    {
      "id": "questie",
      "name": "Questie",
      "author": "breakbb",
      "summary": "Shows quests, objectives and quest givers on the map and minimap.",
      "tags": [
        "quests",
        "map"
      ],
      "added": "2026-11-20",
      "repository": "https://github.com/Questie/Questie",
      "issues": "https://github.com/Questie/Questie/issues",
      "sources": [
        {
          "type": "github",
          "repo": "Questie/Questie",
          "assetPattern": "^Questie-.*\\.zip$",
          "excludePattern": "release\\.json"
        },
        {
          "type": "curseforge",
          "projectId": 334372
        }
      ],
      "folders": [
        "Questie",
        "QuestieDB",
        "QuestieTrace"
      ],
      "tocPath": "Questie/Questie_Forever.toc",
      "notes": "One zip installs three folders: Questie, QuestieDB (its quest database) and QuestieTrace (an optional tracing tool)."
    },
    {
      "id": "syndicator",
      "name": "Syndicator",
      "author": "plusmouse",
      "summary": "Keeps track of items across your characters, for Baganator and others.",
      "tags": [
