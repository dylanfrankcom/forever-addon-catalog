        {
          "type": "github",
          "repo": "Legacy-of-Sylvanaar/wow-instant-messenger",
          "assetPattern": "^WIM-.*\\.zip$",
          "excludePattern": "release\\.json"
        },
        {
          "type": "wago",
          "slug": "wim-wow-instant-messenger-v3"
        },
        {
          "type": "curseforge",
          "projectId": 7474
        }
      ],
      "folders": [
        "WIM"
      ],
      "tocPath": "WIM/WIM.toc",
      "conflicts": [
        "chattynator"
      ],
      "notes": "Releases often. Overlaps with Chattynator's whisper handling."
