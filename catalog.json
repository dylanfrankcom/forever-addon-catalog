  "addons": [
    {
      "id": "auctionator",
      "name": "Auctionator",
      "author": "plusmouse",
      "summary": "Faster auction house searching, shopping lists and price history.",
      "tags": [
        "auction-house"
      ],
      "added": "2026-11-20",
      "sources": [
        {
          "type": "wago",
          "slug": "auctionator"
        },
        {
          "type": "curseforge",
          "projectId": 6124
        }
      ],
      "folders": [
        "Auctionator"
      ],
      "tocPath": "Auctionator/Auctionator.toc",
      "notes": "plusmouse's add-ons download from Wago: the author disabled CurseForge API downloads. CurseForge's published hashes are used to cross-check the Wago file. Works with LibAHTab when it's installed (not in the catalog yet)."
    },
    {
      "id": "baganator",
      "name": "Baganator",
      "author": "plusmouse",
      "summary": "Combined bags and bank with search, sorting and item levels.",
      "tags": [
        "bags"
      ],
      "added": "2026-11-20",
      "sources": [
        {
          "type": "wago",
          "slug": "baganator"
        },
        {
          "type": "curseforge",
          "projectId": 914482
        }
      ],
      "folders": [
        "Baganator"
      ],
      "tocPath": "Baganator/Baganator.toc",
      "requires": [
        "syndicator"
      ],
      "notes": "plusmouse's add-ons download from Wago: the author disabled CurseForge API downloads. CurseForge's published hashes are used to cross-check the Wago file. Needs Syndicator, although its .toc lists it as optional."
    },
    {
      "id": "blizzmove",
      "name": "BlizzMove",
      "author": "numy",
      "summary": "Move and resize the game's default windows.",
      "tags": [
        "ui"
      ],
      "added": "2026-11-20",
      "homepage": "https://www.curseforge.com/wow/addons/blizzmove",
      "repository": "https://github.com/Kiatra/BlizzMove",
      "issues": "https://github.com/Kiatra/BlizzMove/issues",
      "sources": [
        {
          "type": "github",
          "repo": "Kiatra/BlizzMove",
          "assetPattern": "^BlizzMove-v.*\\.zip$"
        },
        {
          "type": "curseforge",
          "projectId": 17809
        }
      ],
      "folders": [
        "BlizzMove",
        "BlizzMove_Debug"
      ],
      "tocPath": "BlizzMove/BlizzMove.toc",
      "notes": "Installs BlizzMove and its load-on-demand debugging plugin together."
    },
    {
      "id": "chattynator",
      "name": "Chattynator",
      "author": "plusmouse",
      "summary": "A replacement chat window with tabs, search and a message log.",
      "tags": [
        "chat"
      ],
      "added": "2026-11-20",
      "sources": [
        {
          "type": "wago",
          "slug": "chattynator"
        },
        {
          "type": "curseforge",
          "projectId": 1273281
        }
      ],
      "folders": [
        "Chattynator"
      ],
      "tocPath": "Chattynator/Chattynator.toc",
      "conflicts": [
        "wim"
      ],
      "notes": "plusmouse's add-ons download from Wago: the author disabled CurseForge API downloads. CurseForge's published hashes are used to cross-check the Wago file. Handles whispers too, so it overlaps with WIM."
    },
    {
      "id": "dungeonjournal",
      "name": "DungeonJournal",
      "author": "exehn",
      "summary": "A journal of Forever's dungeons and raids: bosses, abilities and loot.",
      "tags": [
        "dungeons",
        "loot"
      ],
      "added": "2026-11-20",
      "homepage": "https://www.curseforge.com/wow/addons/dungeonjournal",
      "sources": [
        {
          "type": "curseforge",
          "projectId": 1707971,
          "downloadPage": "https://www.curseforge.com/wow/addons/dungeonjournal/files/all?gameVersionTypeId=88568"
        }
      ],
      "folders": [
        "ForeverDungeonJournal"
      ],
      "tocPath": "ForeverDungeonJournal/ForeverDungeonJournal.toc",
      "notes": "Its folder is ForeverDungeonJournal. It sends a version-check message to other players who have it."
    },
    {
      "id": "gatherlite",
      "name": "GatherLite",
      "author": "wuild",
      "summary": "Records herb, ore and treasure nodes on the map and minimap.",
      "tags": [
        "professions",
        "map"
      ],
      "added": "2026-11-20",
      "homepage": "https://www.curseforge.com/wow/addons/gatherlite",
      "repository": "https://github.com/Wuild/GatherLite",
      "issues": "https://github.com/Wuild/GatherLite/issues",
      "sources": [
        {
          "type": "curseforge",
          "projectId": 334918,
          "downloadPage": "https://www.curseforge.com/wow/addons/gatherlite/files/all?gameVersionTypeId=88568"
        }
      ],
      "folders": [
        "GatherLite"
      ],
      "tocPath": "GatherLite/GatherLite.toc",
      "optional": [
        "openmap"
      ],
      "notes": "CurseForge only: the GitHub repo's releases have no files and stop at 7.6.3."
    },
    {
      "id": "hidingbar",
      "name": "HidingBar",
      "author": "sfmict",
      "summary": "Gathers minimap and data broker buttons into a bar that stays hidden until needed.",
      "tags": [
        "ui",
        "map"
      ],
      "added": "2026-11-20",
      "repository": "https://github.com/sfmict/HidingBar",
      "issues": "https://github.com/sfmict/HidingBar/issues",
      "sources": [
        {
          "type": "github",
          "repo": "sfmict/HidingBar",
          "assetPattern": "^HidingBar-.*\\.zip$"
        },
        {
          "type": "wago",
          "slug": "hidingbar"
        },
        {
          "type": "curseforge",
          "projectId": 369265
        }
      ],
      "folders": [
        "HidingBar",
        "HidingBar_Options"
      ],
      "tocPath": "HidingBar/HidingBar.toc",
      "notes": "HidingBar_Options is a load-on-demand settings add-on that needs HidingBar. The author disabled CurseForge API downloads; CurseForge is listed for its hashes."
    },
    {
      "id": "needroll",
      "name": "NeedRoll",
      "author": "mikebvs",
      "summary": "Browse dungeon and raid loot tables, in the style of AtlasLoot.",
      "tags": [
        "loot",
        "dungeons"
      ],
      "added": "2026-11-20",
      "homepage": "https://www.curseforge.com/wow/addons/needroll",
