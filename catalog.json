    {
      "id": "wim",
      "name": "WIM (WoW Instant Messenger)",
      "author": "pazza",
      "summary": "Whispers in separate instant-messenger windows, with history.",
      "tags": [
        "chat"
      ],
      "added": "2026-11-20",
      "repository": "https://github.com/Legacy-of-Sylvanaar/wow-instant-messenger",
      "issues": "https://github.com/Legacy-of-Sylvanaar/wow-instant-messenger/issues",
