          "excludePattern": "release\\.json"
        },
        {
          "type": "curseforge",
          "projectId": 324944
        }
      ],
      "folders": [
        "WhatsTraining"
      ],
      "tocPath": "WhatsTraining/WhatsTraining.toc",
      "notes": "\"Train All\" is opt-in (/wt options)."
