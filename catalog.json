    {
      "id": "upgradescout",
      "name": "Upgrade Scout",
      "author": "nikita-snetkov",
      "summary": "Finds gear upgrades and consumables on the auction house that you can use and afford.",
      "tags": [
        "auction-house"
      ],
      "added": "2026-11-21",
      "repository": "https://github.com/dibenkobit/upgrade-scout",
      "issues": "https://github.com/dibenkobit/upgrade-scout/issues",
      "sources": [
        {
          "type": "github",
          "repo": "dibenkobit/upgrade-scout",
          "assetPattern": "^UpgradeScout-.*-forever\\.zip$"
        },
        {
          "type": "wago",
          "slug": "upgrade-scout"
        },
        {
          "type": "curseforge",
          "projectId": 1802323
        }
      ],
      "folders": [
        "UpgradeScout"
      ],
      "tocPath": "UpgradeScout/UpgradeScout.toc",
      "notes": "Listed instead of Cheap Upgrades, which does the same job but is on CurseForge only: the catalog prefers add-ons with several sources."
