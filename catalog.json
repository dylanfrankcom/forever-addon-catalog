        "auction-house",
        "economy"
      ],
      "homepage": "https://addons.wago.io/addons/auctionator",
      "sponsor": "https://buymeacoffee.com/plusmouse",
      "sources": [
        {
          "type": "wago",
          "slug": "auctionator"
        },
        {
          "type": "curseforge",
          "projectId": 6124
        }
      ],
      "folders": [
        "Auctionator"
      ],
      "tocPath": "Auctionator/Auctionator.toc",
      "savedVariables": [
        "AUCTIONATOR_CONFIG",
        "AUCTIONATOR_SAVEDVARS",
