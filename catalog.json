    {
      "id": "craftersjournal",
      "name": "Crafter's Journal",
      "author": "bruno",
      "summary": "The cheapest way to level each profession and collect its recipes, with where to get each recipe.",
      "tags": [
        "professions",
        "auction-house"
      ],
      "added": "2026-11-21",
      "repository": "https://github.com/brunobasas/CraftersJournal",
      "issues": "https://github.com/brunobasas/CraftersJournal/issues",
      "sources": [
        {
          "type": "github",
          "repo": "brunobasas/CraftersJournal",
          "assetPattern": "^CraftersJournal-.*-forever\\.zip$"
        },
        {
          "type": "curseforge",
          "projectId": 1752523
        }
      ],
      "folders": [
        "CraftersJournal"
      ],
      "tocPath": "CraftersJournal/CraftersJournal.toc",
      "optional": [
        "auctionator",
        "questie"
      ]
