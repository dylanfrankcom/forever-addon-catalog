{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dylanfrankcom/forever-addon-catalog/schema/optout.schema.json",
  "title": "Forever Add-on Catalog: the never-add list",
  "description": "optout.json: GitHub repos (owner/name) or whole accounts (owner) that discovery skips and the generator never lists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repos"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "repos": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]+(/[A-Za-z0-9._-]+)?$"
      }
    }
  }
}
