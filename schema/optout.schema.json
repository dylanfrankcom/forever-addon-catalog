{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dylanfrankcom/forever-addon-catalog/schema/optout.schema.json",
  "title": "Forever Add-on Catalog: the never-add list",
  "description": "optout.json: GitHub repos (owner/name) or whole accounts (owner) that discovery skips and the generator never lists, each with why and when: an author's request, or the maintainer's decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repos"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "reason"
        ],
        "properties": {
          "repo": {
            "description": "owner/name for one repo, owner for a whole account.",
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+(/[A-Za-z0-9._-]+)?$"
          },
          "reason": {
            "description": "Why it's never listed: the author asked (and how), or what the maintainer decided.",
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "date": {
            "description": "The day it was added (YYYY-MM-DD).",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "issue": {
            "description": "The catalog issue that asked for it.",
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
